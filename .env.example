# Copy this file to .env and fill it in. Never share or commit your .env.
# On a host like Railway, Render or Fly, set these as environment variables instead.

# From https://discord.com/developers/applications -> your app
# Bot tab -> Reset Token
DISCORD_TOKEN=
# OAuth2 tab -> Client ID
DISCORD_CLIENT_ID=
# OAuth2 tab -> Reset Secret (needed for dashboard login)
DISCORD_CLIENT_SECRET=

# The address people use to reach the dashboard, without a trailing slash.
# Locally: http://localhost:8080    Deployed: https://your-app.example.com
# Also add <PUBLIC_URL>/callback under OAuth2 -> Redirects in the Developer Portal.
PUBLIC_URL=http://localhost:8080

# Optional but recommended: free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional: extra Discord user IDs (comma-separated) who can open the /admin owner page.
# The bot's owner (or team members) in the Developer Portal always can.
OWNER_IDS=

PORT=8080
